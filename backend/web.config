<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified"/>
    </handlers>
    
    <!-- Azure App Service Configuration for Long-Running Streaming Requests -->
    <httpPlatform 
      processPath="D:\home\Python311\python.exe" 
      arguments="D:\home\site\wwwroot\startup.py" 
      stdoutLogEnabled="true" 
      stdoutLogFile="D:\home\LogFiles\python.log" 
      startupTimeLimit="60" 
      startupRetryCount="3"
      requestTimeout="00:10:00">
      <!-- 10 minute timeout for long-running requests -->
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%"/>
        <environmentVariable name="PYTHONUNBUFFERED" value="1"/>
        <!-- Disable Python buffering for real-time streaming -->
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production"/>
      </environmentVariables>
    </httpPlatform>
    
    <!-- CRITICAL: Disable ALL buffering for Server-Sent Events (SSE) -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Accel-Buffering" value="no" />
        <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        <add name="Pragma" value="no-cache" />
        <add name="Expires" value="0" />
      </customHeaders>
    </httpProtocol>
    
    <!-- Disable IIS response buffering based on frequent hit detection -->
    <serverRuntime frequentHitThreshold="1" frequentHitTimePeriod="00:00:00" />
    
    <!-- Disable ARR (Application Request Routing) response buffering -->
    <rewrite>
      <outboundRules>
        <rule name="DisableResponseBuffering">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="no-cache, no-store, must-revalidate" />
        </rule>
      </outboundRules>
    </rewrite>
    
    <!-- Disable compression for streaming endpoints -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    
    <!-- Security headers (optional but recommended) -->
    <httpErrors errorMode="Detailed" />
  </system.webServer>
</configuration>